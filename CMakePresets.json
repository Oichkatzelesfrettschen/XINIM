{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "XINIM_ENABLE_WERROR": "ON"
      }
    },
    {
      "name": "x86-elf-cross-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "XINIM_X86_32_TOOLCHAIN_MODE": "cross-elf"
      }
    },
    {
      "name": "x86_64-debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/x86_64/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/x86_64/Debug/generators/conan_toolchain.cmake",
        "XINIM_CPU_LANE": "x86_64"
      }
    },
    {
      "name": "x86_64-release",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/x86_64/Release",
