{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "XINIM_ENABLE_WERROR": "ON"
      }
    },
    {
      "name": "i486-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY",
        "XINIM_CPU_LANE": "i486"
      }
    },
    {
      "name": "i486-standalone",
      "description": "i486 debug build",
      "inherits": "i486-base",
      "binaryDir": "${sourceDir}/build/i486/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "i486-release",
      "description": "i486 release build with -O3 and Thin LTO",
      "inherits": "i486-base",
      "binaryDir": "${sourceDir}/build/i486/Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF",
        "XINIM_PGO_MODE": "none"
      }
    },
    {
      "name": "i486-pgo-generate",
      "description": "i486 PGO phase 1: instrumented build for profile collection",
      "inherits": "i486-base",
      "binaryDir": "${sourceDir}/build/i486/PgoGenerate",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF",
        "XINIM_PGO_MODE": "generate"
      }
    },
    {
      "name": "i486-pgo-use",
      "description": "i486 PGO phase 2: profile-guided optimized build (set XINIM_PGO_DATA)",
      "inherits": "i486-base",
      "binaryDir": "${sourceDir}/build/i486/PgoUse",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF",
        "XINIM_PGO_MODE": "use",
        "XINIM_PGO_DATA": "${sourceDir}/build/i486/pgo.profdata"
      }
    },
    {
      "name": "i586-standalone",
      "description": "i586 debug build",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/i586/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY",
        "XINIM_CPU_LANE": "i586"
      }
    },
    {
      "name": "i686-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY",
        "XINIM_CPU_LANE": "i686"
      }
    },
    {
      "name": "i686-standalone",
      "description": "i686 debug build",
      "inherits": "i686-base",
      "binaryDir": "${sourceDir}/build/i686/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "i686-release",
      "description": "i686 release build with -O3 and Thin LTO",
      "inherits": "i686-base",
      "binaryDir": "${sourceDir}/build/i686/Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF",
        "XINIM_PGO_MODE": "none"
      }
    },
    {
      "name": "i686-pgo-generate",
      "description": "i686 PGO phase 1: instrumented build for profile collection",
      "inherits": "i686-base",
      "binaryDir": "${sourceDir}/build/i686/PgoGenerate",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF",
        "XINIM_PGO_MODE": "generate"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "i486-standalone",
      "configurePreset": "i486-standalone"
    },
    {
      "name": "i486-release",
      "configurePreset": "i486-release"
    },
    {
      "name": "i486-pgo-generate",
      "configurePreset": "i486-pgo-generate"
    },
    {
      "name": "i486-pgo-use",
      "configurePreset": "i486-pgo-use"
    },
    {
      "name": "i586-standalone",
      "configurePreset": "i586-standalone"
    },
    {
      "name": "i686-standalone",
      "configurePreset": "i686-standalone"
    },
    {
      "name": "i686-release",
      "configurePreset": "i686-release"
    },
    {
      "name": "i686-pgo-generate",
      "configurePreset": "i686-pgo-generate"
    }
  ],
  "testPresets": [
    {
      "name": "i486-standalone",
      "configurePreset": "i486-standalone",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "i486-vbox",
      "configurePreset": "i486-release",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "vbox"
        }
      }
    },
    {
      "name": "i686-standalone",
      "configurePreset": "i686-standalone",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
