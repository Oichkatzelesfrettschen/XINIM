{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "XINIM_ENABLE_WERROR": "ON"
      }
    },
    {
      "name": "i486-standalone",
      "description": "i486 debug build (pure CMake, no Conan)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/i486/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY",
        "XINIM_CPU_LANE": "i486"
      }
    },
    {
      "name": "i586-standalone",
      "description": "i586 debug build (pure CMake, no Conan)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/i586/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY",
        "XINIM_CPU_LANE": "i586"
      }
    },
    {
      "name": "i686-standalone",
      "description": "i686 debug build (pure CMake, no Conan)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/i686/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY",
        "XINIM_CPU_LANE": "i686"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "i486-standalone",
      "configurePreset": "i486-standalone"
    },
    {
      "name": "i586-standalone",
      "configurePreset": "i586-standalone"
    },
    {
      "name": "i686-standalone",
      "configurePreset": "i686-standalone"
    }
  ],
  "testPresets": [
    {
      "name": "i486-standalone",
      "configurePreset": "i486-standalone",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
