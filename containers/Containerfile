# XINIM: Lightweight Container for Building, Testing, and Debugging
# Compatible with Docker and Podman
# Multi-stage build for minimal footprint

# =============================================================================
# Stage 1: Base Image with Essential Build Tools
# =============================================================================
FROM docker.io/library/ubuntu:24.04 AS base

# Prevent apt from prompting for user input
ENV DEBIAN_FRONTEND=noninteractive

# Install minimal base dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# Add LLVM apt repository for clang-21
RUN curl -fsSL https://apt.llvm.org/llvm-snapshot.gpg.key | gpg --dearmor -o /usr/share/keyrings/llvm-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/llvm-archive-keyring.gpg] http://apt.llvm.org/noble/ llvm-toolchain-noble-21 main" > /etc/apt/sources.list.d/llvm.list

# =============================================================================
# Stage 2: Build Environment (Lightweight)
# =============================================================================
FROM base AS build-env

# Install C++23 toolchain and essential build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Core build tools
    build-essential \
    ninja-build \
    cmake \
    pkg-config \
    # LLVM/Clang toolchain
    clang-21 \
    lld-21 \
    lldb-21 \
    clang-tools-21 \
    clang-tidy-21 \
    clang-format-21 \
    libc++-21-dev \
    libc++abi-21-dev \
    # Assembly
    nasm \
    # Libraries
    libsodium-dev \
    # Useful utilities
    git \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create symbolic links for clang tools
RUN update-alternatives --install /usr/bin/cc cc /usr/bin/clang-21 100 \
    && update-alternatives --install /usr/bin/c++ c++ /usr/bin/clang++-21 100 \
    && update-alternatives --install /usr/bin/clang clang /usr/bin/clang-21 100 \
    && update-alternatives --install /usr/bin/clang++ clang++ /usr/bin/clang++-21 100 \
    && update-alternatives --install /usr/bin/ld ld /usr/bin/lld-21 100 \
    && update-alternatives --install /usr/bin/clang-format clang-format /usr/bin/clang-format-21 100 \
    && update-alternatives --install /usr/bin/clang-tidy clang-tidy /usr/bin/clang-tidy-21 100

# Install Conan package manager
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir conan

ENV PATH="/opt/venv/bin:${PATH}"

# Create working directory
WORKDIR /xinim

# Default build command
CMD ["bash", "-lc", "conan install . -pr:h=conan/profiles/clang-x86_64 -s build_type=Debug -o '&:lane=x86_64' -of build/x86_64/Debug --build=missing && cmake --preset x86_64-debug && cmake --build --preset x86_64-debug"]

# =============================================================================
# Stage 3: Test Environment (includes QEMU for kernel testing)
# =============================================================================
FROM build-env AS test-env

# Install testing dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    # QEMU for kernel testing
    qemu-system-x86 \
    qemu-utils \
    # Debugging tools
    gdb \
    valgrind \
    # Coverage tools
    lcov \
    # Static analysis
    cppcheck \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Install Python testing tools
RUN /opt/venv/bin/pip install --no-cache-dir \
    pytest \
    lizard

# Default test command
CMD ["bash", "-lc", "conan install . -pr:h=conan/profiles/clang-x86_64 -s build_type=Debug -o '&:lane=x86_64' -of build/x86_64/Debug --build=missing && cmake --preset x86_64-debug && cmake --build --preset x86_64-debug && ctest --preset x86_64-debug -L unit"]

# =============================================================================
# Stage 4: Debug Environment (full debugging support)
# =============================================================================
FROM test-env AS debug-env

# Install additional debugging dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Advanced debugging
    strace \
    ltrace \
    # Performance profiling
    linux-tools-generic \
    # Memory debugging
    libasan8 \
    libtsan2 \
    libubsan1 \
    # Editor for in-container editing
    vim \
    less \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Configure GDB for kernel debugging
RUN echo 'set architecture i386:x86-64' > /root/.gdbinit \
    && echo 'set disassembly-flavor intel' >> /root/.gdbinit \
    && echo 'set pagination off' >> /root/.gdbinit

# Enable kernel debugging via QEMU
ENV XINIM_DEBUG=1

# Default debug command (starts GDB server)
CMD ["/bin/bash"]

# =============================================================================
# Stage 5: CI Environment (optimized for GitHub Actions)
# =============================================================================
FROM test-env AS ci-env

# Install CI-specific tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    # For GitHub Actions caching
    zip \
    unzip \
    # Documentation generation
    doxygen \
    graphviz \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set up CI-friendly environment
ENV CI=true
ENV XINIM_CI=1

# Default CI command
CMD ["bash", "-lc", "conan install . -pr:h=conan/profiles/clang-x86_64 -s build_type=Debug -o '&:lane=x86_64' -of build/x86_64/Debug --build=missing && cmake --preset x86_64-debug && cmake --build --preset x86_64-debug && ctest --preset x86_64-debug -L unit"]

# =============================================================================
# Stage 6: Minimal Runtime (for deployment/distribution)
# =============================================================================
FROM docker.io/library/ubuntu:24.04 AS runtime

# Minimal runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    qemu-system-x86 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

WORKDIR /xinim

# Copy only the built kernel.
# NOTE: This stage requires a pre-built 'xinim' kernel binary to be present
# in the build context at image build time. Build the kernel first, then
# copy it to the repo root before building this stage:
#   ./containers/container.sh build
#   cp build/x86_64/Debug/xinim ./xinim
#   docker build --target runtime -t xinim-runtime -f containers/Containerfile .
COPY xinim /xinim/xinim

CMD ["qemu-system-x86_64", "-kernel", "/xinim/xinim", "-nographic", "-no-reboot"]
