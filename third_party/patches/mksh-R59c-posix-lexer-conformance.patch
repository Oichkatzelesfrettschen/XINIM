+static bool
+source_capture_contains(const struct source_capture *capture, Source *frame)
+{
+	size_t frame_index;
+
+	for (frame_index = 0; frame_index < capture->frame_count; ++frame_index)
+		if (capture->frames[frame_index] == frame)
+			return (true);
+	return (false);
+}
+
+static bool
+source_capture_position_is_raw(const Source *frame, const char *position)
+{
+	if ((frame->type == SALIAS || frame->type == SREREAD) &&
+	    position == frame->ugbuf)
+		return (false);
+	return (true);
+}
+
+static void
+source_capture_record(Source *frame, const char *position, int c)
+{
+	struct source_capture *capture = source_capture_info;
+
+	if (c == 0 || !source_capture_position_is_raw(frame, position))
+		return;
+	while (capture != NULL) {
+		if (source_capture_contains(capture, frame)) {
+			Xcheck(capture->xs, capture->xp);
+			*capture->xp++ = c;
+		}
+		capture = capture->next;
+	}
+}
+
+static void
+source_capture_unread(Source *frame, const char *position, int c)
+{
+	struct source_capture *capture = source_capture_info;
+
+	if (c == 0 || !source_capture_position_is_raw(frame, position))
+		return;
+	while (capture != NULL) {
+		if (source_capture_contains(capture, frame)) {
+			if (Xlength(capture->xs, capture->xp) == 0 ||
+			    (unsigned char)capture->xp[-1] != (unsigned int)c)
+				internal_errorf("source capture rewind mismatch");
+			--capture->xp;
+		}
+		capture = capture->next;
+	}
+}
+
+static int
+source_read_byte(Source *frame)
+{
+	const char *position = frame->str;
+	int c = ord(*frame->str++);
+
+	if (c != 0 && source_capture_position_is_raw(frame, position)) {
+		last_source_byte_frame = frame;
+		last_source_byte_position = position;
+	}
+	source_capture_record(frame, position, c);
+	return (c);
+}
+
+bool
+source_last_byte_is(Source *frame, const char *position)
+{
+	return (last_source_byte_frame == frame &&
+	    last_source_byte_position == position);
+}
+
+static int
+getsc_u(void)
+{
+	if (*source->str != '\0')
+		return (source_read_byte(source));
+	return (getsc_uu());
+}
+
+void
+source_capture_begin(void)
+{
+	struct source_capture *capture;
+	Source *frame;
+	size_t frame_index;
+	size_t frame_count = 0;
+
+	for (frame = source; frame != NULL; frame = frame->next)
+		++frame_count;
+	capture = alloc(sizeof(struct source_capture), ATEMP);
+	capture->frames = alloc2(frame_count, sizeof(Source *), ATEMP);
+	capture->frame_count = frame_count;
+	frame_index = 0;
+	for (frame = source; frame != NULL; frame = frame->next)
+		capture->frames[frame_index++] = frame;
+	Xinit(capture->xs, capture->xp, 64, ATEMP);
+	capture->alias_lookup_count = 0;
+	capture->next = source_capture_info;
+	source_capture_info = capture;
+}
+
+static char *
+source_capture_take(bool emit_trace)
+{
+	struct source_capture *capture = source_capture_info;
+	char *cp;
+
+	if (capture == NULL)
+		internal_errorf("source_capture_finish: no active capture");
+	Xcheck(capture->xs, capture->xp);
+	*capture->xp = '\0';
+	cp = Xstring(capture->xs, capture->xp);
+#ifdef MKSH_XINIM_CAPTURE_TEST
+	if (emit_trace) {
+		const char hex[] = "0123456789abcdef";
+		char *trace_position;
+
+		shf_fprintf(shl_out, "XINIM_CAPTURE bytes=");
+		for (trace_position = cp; trace_position < capture->xp;
+		    ++trace_position) {
+			unsigned int byte = (unsigned char)*trace_position;
+
+			shf_putchar(hex[byte >> 4], shl_out);
+			shf_putchar(hex[byte & 15], shl_out);
+		}
+		shf_fprintf(shl_out, " scan_alias_lookups=%u\n",
+		    capture->alias_lookup_count);
+		shf_flush(shl_out);
+	}
+#else
+	(void)emit_trace;
+#endif
+	source_capture_info = capture->next;
+	return (cp);
+}
+
+char *
+source_capture_finish(void)
+{
+	return (source_capture_take(true));
+}
+
+void
+source_capture_cancel(void)
+{
+	(void)source_capture_take(false);
+}
+
+void
+source_capture_prepare_replay(const char *prefix)
+{
+	struct source_capture *capture;
+	size_t prefix_length = strlen(prefix);
+
+	source_capture_begin();
+	capture = source_capture_info;
+	XcheckN(capture->xs, capture->xp, prefix_length);
+	memcpy(capture->xp, prefix, prefix_length);
+	capture->xp += prefix_length;
+	pending_source_capture = capture;
+}
+
+bool
+source_capture_adopt_pending(void)
+{
+	if (pending_source_capture == NULL)
+		return (false);
+	if (pending_source_capture != source_capture_info)
+		internal_errorf("pending source capture is not active");
+	pending_source_capture = NULL;
+	return (true);
+}
+
+struct source_capture *
+source_capture_parent(void)
+{
+	if (source_capture_info == NULL)
+		internal_errorf("source capture has no parent");
+	return (source_capture_info->next);
+}
+
+void
+source_capture_restore_environment(void)
+{
+	source_capture_info = e->old_source_capture;
+	pending_source_capture = e->old_pending_source_capture;
+}
