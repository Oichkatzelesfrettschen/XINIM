+static void
+scan_comsub_boundary(void)
+{
+	struct comsub_case_state *case_state = NULL;
+	unsigned int parenthesis_depth = 0;
+	unsigned int test_parenthesis_depth = 0;
+	bool command_position = true;
+	bool in_double_bracket = false;
+	int c;
+	int lexer_flags;
+
+	while (/* CONSTCOND */ 1) {
+		if (in_double_bracket)
+			lexer_flags = CMDASN;
+		else if (case_state != NULL &&
+		    case_state->phase == COMSUB_CASE_IN)
+			lexer_flags = KEYWORD;
+		else if (case_state != NULL &&
+		    case_state->phase == COMSUB_CASE_PATTERN)
+			lexer_flags = KEYWORD | ESACONLY;
+		else
+			lexer_flags = command_position ? KEYWORD | CMDASN : 0;
+
+		c = yylex(lexer_flags);
+
+ process_token:
+		if (c == 0)
+			yyerror("missing closing parenthesis");
+
+		if (in_double_bracket) {
+			if (c == LWORD && strcmp(ident, "]]") == 0) {
+				in_double_bracket = false;
+				command_position = false;
+			} else if ((unsigned int)c == ORD('('))
+				++test_parenthesis_depth;
+			else if ((unsigned int)c == ORD(')')) {
+				if (test_parenthesis_depth != 0)
+					--test_parenthesis_depth;
+				else if (parenthesis_depth != 0)
+					--parenthesis_depth;
+				else
+					return;
+			}
+			continue;
+		}
+
+		if (case_state != NULL) {
+			if (case_state->phase == COMSUB_CASE_WORD &&
+			    (unsigned int)c != ORD(')')) {
+				if (c == LWORD)
+					case_state->phase = COMSUB_CASE_IN;
+				continue;
+			}
+			if (case_state->phase == COMSUB_CASE_IN &&
+			    (unsigned int)c != ORD(')')) {
+				if (c == IN || ((unsigned int)c == ORD('{'))) {
+					case_state->phase = COMSUB_CASE_PATTERN;
+					case_state->pattern_started = false;
+				}
+				continue;
+			}
+			if (case_state->phase == COMSUB_CASE_PATTERN) {
+				if (c == ESAC || (unsigned int)c == ORD('}')) {
+					struct comsub_case_state *closed_case = case_state;
+
+					case_state = closed_case->next;
+					afree(closed_case, ATEMP);
+					command_position = false;
+				} else if ((unsigned int)c == ORD(')')) {
+					case_state->phase = COMSUB_CASE_BODY;
+					command_position = true;
+				} else if ((unsigned int)c == ORD('(') &&
+				    !case_state->pattern_started)
