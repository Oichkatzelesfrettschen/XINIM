+static bool
+parse_redirection_unit(const char *word, size_t length, short *unit)
+{
+	size_t index;
+	unsigned int digit;
+	unsigned int value = 0;
+
+	if (length == 0 || (length & 1) != 0)
+		return (false);
+	for (index = 0; index < length; index += 2) {
+		if (word[index] != CHAR ||
+		    !ctype(word[index + 1], C_DIGIT))
+			return (false);
+		digit = ksh_numdig(word[index + 1]);
+		if (value > ((unsigned int)NUFILE - 1U - digit) / 10U)
+			yyerror("file descriptor is out of range");
+		value = value * 10U + digit;
+	}
+	*unit = (short)value;
+	return (true);
+}
