+static int
+scan_comsub_redirection(struct ioword *iop)
+{
+	bool ishere = (iop->ioflag & IOTYPE) == IOHERE;
+	int c;
+
+	if (iop->ioflag & IOHERESTR)
+		c = yylex(0);
+	else if (ishere && (c = yylex(HEREDELIM)) == ORD('\n')) {
+		yylval.cp = wdcopy(IONDELIM_delim, ATEMP);
+		iop->ioflag |= IOEVAL | IONDELIM;
+		c = LWORD;
+	} else if (!ishere)
+		c = yylex(0);
+
+	if (c != LWORD)
+		return (c);
+
+	if (ishere) {
+		iop->delim = yylval.cp;
+		if (*ident != 0 && !(iop->ioflag & IOHERESTR))
+			iop->ioflag |= IOEVAL;
+		if (herep > &heres[HERES - 1])
+			yyerror(Tf_toomany, "<<");
+		*herep++ = iop;
+	} else
+		iop->ioname = yylval.cp;
+
+	return (LWORD);
