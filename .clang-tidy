---
# The compiled i486 kernel is freestanding C++23. Keep checks that can
# establish defects without assuming hosted C++ or ownership of C/assembly
# ABI layouts. See docs/analysis/CLANG_TIDY_PROFILE.md.
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  misc-redundant-expression,
  readability-braces-around-statements,
  -bugprone-easily-swappable-parameters,
  -bugprone-suspicious-include,
  -cert-err52-cpp,
  -clang-analyzer-core.FixedAddressDereference,
  -clang-analyzer-optin.performance.Padding

WarningsAsErrors: '*'
