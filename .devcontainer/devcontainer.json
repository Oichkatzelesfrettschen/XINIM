// XINIM Development Container Configuration
// Optimized for C++23 development with xmake build system
{
	"name": "XINIM C++23 Development",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"features": {
		"ghcr.io/devcontainers/features/git-lfs:1": {
			"autoPull": true,
			"installDirectlyFromGitHubRelease": true,
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/github-cli:1": {
			"installDirectlyFromGitHubRelease": true,
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/python:1": {
			"installTools": true,
			"optimize": true,
			"enableShared": true,
			"version": "3.12"
		},
		"ghcr.io/chaoswars/vscode-features/llvm:1": {
			"llvm-version": "18"
		}
	},

	// Forward QEMU GDB port for kernel debugging
	"forwardPorts": [1234],

	// Run xmake config after container creation
	"postCreateCommand": "sh -lc 'if [ -f xmake.lua ]; then xmake config --toolchain=clang; else echo \"xmake.lua not found, skipping xmake config\"; fi'",

	// VSCode customizations for C++23 development
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools",
				"ms-vscode.cmake-tools",
				"llvm-vs-code-extensions.vscode-clangd",
				"ms-python.python",
				"ms-azuretools.vscode-docker"
			],
			"settings": {
				"C_Cpp.default.cppStandard": "c++23",
				"C_Cpp.default.cStandard": "c17",
				"clangd.arguments": [
					"--background-index",
					"--clang-tidy",
					"--header-insertion=iwyu"
				]
			}
		}
	},

	// Optional: Mount KVM device for acceleration on supported hosts.
	// To enable on Linux with KVM, set: export DEVCONTAINER_KVM_DEVICE="--device=/dev/kvm"
	// On hosts without KVM (macOS, Windows), leave unset or empty.
	"runArgs": ["${localEnv:DEVCONTAINER_KVM_DEVICE}"],

	// Use non-root user for security
	"remoteUser": "vscode"
}
